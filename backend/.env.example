DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set by the deploy host in production; falls back to SQLite locally when unset.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Nominatim requires an identifying User-Agent with contact details.
UPSTREAM_USER_AGENT=fmcsa-hos-trip-planner/1.0 (you@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
UPSTREAM_TIMEOUT_SECONDS=15
